# API and worker runtime configuration
NODE_ENV=development
APP_NAME=customer-operations-platform
APP_VERSION=development
API_PORT=3001
LOG_LEVEL=info

# Web shell runtime
WEB_PORT=3000

# Observability export (reserved for a future milestone; not used in C01)
OTEL_EXPORTER_OTLP_ENDPOINT=

# PostgreSQL development-only example values (consumed by the API in C02)
POSTGRES_DB=customer_ops
POSTGRES_USER=customer_ops
POSTGRES_PASSWORD=local_development_only
DATABASE_URL=postgresql://customer_ops:local_development_only@localhost:5432/customer_ops
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=15000
DB_IDLE_TRANSACTION_TIMEOUT_MS=30000

# Redis/queue development-only example values (consumed by the worker in C03)
REDIS_URL=redis://localhost:6379
QUEUE_PREFIX=customer-ops
WORKER_CONCURRENCY=5
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_HEALTH_TIMEOUT_MS=2000
WORKER_SHUTDOWN_TIMEOUT_MS=15000

# Future security milestone (set strong local values before use)
APP_SECRET=replace-with-a-long-random-local-value

# Future storage milestone (local MinIO)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=customer-ops-local
S3_ACCESS_KEY=minio_local
S3_SECRET_KEY=minio_local_development_only

# Meta WhatsApp (future; intentionally blank)
META_WHATSAPP_APP_ID=
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_VERIFY_TOKEN=

# Email (future; intentionally blank)
EMAIL_FROM=
EMAIL_PROVIDER_API_KEY=
